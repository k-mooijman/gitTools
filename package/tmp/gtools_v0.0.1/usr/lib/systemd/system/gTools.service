[Unit]
Description=Kasper's git tools
#After=network-online.target
#Wants=network-online.target

StartLimitIntervalSec=600s
StartLimitBurst=30

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/default/gtools
ExecStart=/usr/bin/gtools
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
